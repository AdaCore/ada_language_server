               "processId": 1,
               "rootUri": "$URI{.}",
               "capabilities": {}
            }
         },
         "wait": [
            {
               "id": 0,
               "result": {
                  "capabilities": {
                     "executeCommandProvider": {
                        "commands": [
                           "<HAS>",
                           "als-unit-hierarchy-information"
                        ]
                     }
                  }
               }
            }
         ]
      }
   },
