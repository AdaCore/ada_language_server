[
   {
      "comment": [
         "GPR keyword completion after a project qualifier"
      ]
   },
   {
      "start": {
         "cmd": [
            "${ALS}",
            "--language-gpr"
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
               "rootUri": "$URI{.}",
               "capabilities": {}
            }
         },
         "wait": [
            {
               "id": 1,
               "result": {
                  "capabilities": {
                     "textDocumentSync": {
                        "openClose": true,
                        "change": 1
                     },
                     "documentSymbolProvider": {}
                  }
               }
            }
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "initialized"
         },
         "wait": []
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "workspace/didChangeConfiguration",
            "params": {
               "settings": {
                  "ada": {
                     "gprFileDiagnostics": false
                  }
               }
            }
         },
         "wait": []
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "textDocument/didOpen",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}",
                  "languageId": "Gpr",
                  "version": 0,
                  "text": "limited \nproject Default is\nend Default;\n"
               }
            }
         },
         "wait": []
      }
   },
   {
      "comment": [
         "After 'limited': only 'with' may follow"
      ]
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "textDocument/completion",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}"
               },
               "position": {
                  "line": 0,
                  "character": 8
               },
               "context": {
                  "triggerKind": 1
               }
            }
         },
         "wait": [
            {
               "id": 2,
               "result": {
                  "isIncomplete": false,
                  "items": [
                     {
                        "label": "with",
                        "kind": 14
                     }
                  ]
               }
            }
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "textDocument/didChange",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}",
                  "version": 1
               },
               "contentChanges": [
                  {
                     "range": {
                        "start": {
                           "line": 0,
                           "character": 0
                        },
                        "end": {
                           "line": 0,
                           "character": 8
                        }
                     },
                     "text": "abstract "
                  }
               ]
            }
         },
         "wait": []
      }
   },
   {
      "comment": [
         "After the 'abstract' qualifier: 'project'"
      ]
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "textDocument/completion",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}"
               },
               "position": {
                  "line": 0,
                  "character": 9
               },
               "context": {
                  "triggerKind": 1
               }
            }
         },
         "wait": [
            {
               "id": 3,
               "result": {
                  "isIncomplete": false,
                  "items": [
                     {
                        "label": "project",
                        "kind": 14
                     }
                  ]
               }
            }
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "textDocument/didChange",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}",
                  "version": 2
               },
               "contentChanges": [
                  {
                     "range": {
                        "start": {
                           "line": 0,
                           "character": 0
                        },
                        "end": {
                           "line": 0,
                           "character": 9
                        }
                     },
                     "text": "library "
                  }
               ]
            }
         },
         "wait": []
      }
   },
   {
      "comment": [
         "After the 'library' qualifier, an identifier: 'project'"
      ]
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 4,
            "method": "textDocument/completion",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}"
               },
               "position": {
                  "line": 0,
                  "character": 8
               },
               "context": {
                  "triggerKind": 1
               }
            }
         },
         "wait": [
            {
               "id": 4,
               "result": {
                  "isIncomplete": false,
                  "items": [
                     {
                        "label": "project",
                        "kind": 14
                     }
                  ]
               }
            }
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "textDocument/didChange",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}",
                  "version": 3
               },
               "contentChanges": [
                  {
                     "range": {
                        "start": {
                           "line": 0,
                           "character": 0
                        },
                        "end": {
                           "line": 0,
                           "character": 8
                        }
                     },
                     "text": "aggregate "
                  }
               ]
            }
         },
         "wait": []
      }
   },
   {
      "comment": [
         "After 'aggregate': 'project' or 'library project'"
      ]
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 5,
            "method": "textDocument/completion",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}"
               },
               "position": {
                  "line": 0,
                  "character": 10
               },
               "context": {
                  "triggerKind": 1
               }
            }
         },
         "wait": [
            {
               "id": 5,
               "result": {
                  "isIncomplete": false,
                  "items": [
                     {
                        "label": "project",
                        "kind": 14
                     },
                     {
                        "label": "library",
                        "kind": 14
                     }
                  ]
               }
            }
         ]
      }
   },
   {
      "stop": {
         "exit_code": 0
      }
   }
]
