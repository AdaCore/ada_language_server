[
   {
      "comment": [
         "GPR keyword completion at start of file"
      ]
   },
   {
      "start": {
         "cmd": [
            "${ALS}",
            "--language-gpr"
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
               "rootUri": "$URI{.}",
               "capabilities": {}
            }
         },
         "wait": [
            {
               "id": 1,
               "result": {
                  "capabilities": {
                     "textDocumentSync": {
                        "openClose": true,
                        "change": 1
                     },
                     "documentSymbolProvider": {}
                  }
               }
            }
         ]
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "initialized"
         },
         "wait": []
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "workspace/didChangeConfiguration",
            "params": {
               "settings": {
                  "ada": {
                     "gprFileDiagnostics": false
                  }
               }
            }
         },
         "wait": []
      }
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "method": "textDocument/didOpen",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}",
                  "languageId": "Gpr",
                  "version": 0,
                  "text": ""
               }
            }
         },
         "wait": []
      }
   },
   {
      "comment": [
         "Empty file: propose file-start keywords"
      ]
   },
   {
      "send": {
         "request": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "textDocument/completion",
            "params": {
               "textDocument": {
                  "uri": "$URI{default.gpr}"
               },
               "position": {
                  "line": 0,
                  "character": 0
               },
               "context": {
                  "triggerKind": 1
               }
            }
         },
         "wait": [
            {
               "id": 2,
               "result": {
                  "isIncomplete": false,
                  "items": [
                     {
                        "label": "with",
                        "kind": 14
                     },
                     {
                        "label": "limited",
                        "kind": 14
                     },
                     {
                        "label": "project",
                        "kind": 14
                     },
                     {
                        "label": "abstract",
                        "kind": 14
                     },
                     {
                        "label": "library",
                        "kind": 14
                     }
                  ]
               }
            }
         ]
      }
   },
   {
      "stop": {
         "exit_code": 0
      }
   }
]
